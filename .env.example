# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: OpenRouter image model (default: "google/gemini-3.1-flash-image")
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# SQLite database file path (default: ./dev.db in the project directory).
# Leave unset for local dev. Docker sets this to /data/dev.db via docker-compose.
# DATABASE_PATH=/data/dev.db

# Optional: override the yt-dlp binary path (default: "yt-dlp" on PATH)
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# Instance language ("de" or "en", default: "de")
# APP_LOCALE=de

# Authentication
# Generate a secret via `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Set to "true" to disable new email/password user registrations (existing users can still log in)
# AUTH_DISABLE_REGISTER=false
# Set to "true" to completely disable email/password auth and allow SSO only (requires OIDC)
# AUTH_DISABLE_EMAIL_LOGIN=false

# Optional: OpenID Connect (OIDC) / SSO
# OIDC_PROVIDER_NAME="SSO"
# OIDC_DISCOVERY_URL=https://auth.example.com/realms/master/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES="openid profile email"
